{
	"name": "svelte-whitespace",
	"version": "0.0.0",
	"private": true,
	"description": "A JSX-style whitespace formatter for Svelte, including a preprocessor and a Prettier plugin with configuration for behaviour",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/preprocess/index.d.ts",
			"default": "./dist/preprocess/index.js"
		},
		"./prettier": {
			"types": "./dist/prettier/index.d.ts",
			"default": "./dist/prettier/index.js"
		}
	},
	"bin": {
		"svelte-whitespace": "./dist/cli/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"prettier": "^3.0.0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"prettier-plugin-svelte": "~3.5.2"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"prettier": "^3.8.3",
		"svelte": "^5.55.7",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
